---
import { companyInfo } from '../data/siteContent';
---

<section id="home" class="relative bg-brand-950 text-white overflow-hidden">
  <!-- Background Image with Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1558769132-cb1aea458c5e?auto=format&fit=crop&w=1920&q=80"
      alt="Jinhua Luoyi Textile Co., Ltd. Manufacturing & Fabrics"
      class="w-full h-full object-cover object-center opacity-25 scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/95 to-brand-900/75"></div>
    <div class="absolute inset-0 bg-hero-grid"></div>
  </div>

  <!-- Decorative Glow -->
  <div
    class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-gold-500/15 blur-3xl pointer-events-none"
  ></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Core B2B Value Proposition -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Badge -->
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-gold-400/30 backdrop-blur-sm text-xs sm:text-sm font-medium text-gold-300"
        >
          <span class="w-2 h-2 rounded-full bg-gold-400"></span>
          <span class="lang-en">{companyInfo.name.en} · YIWU CHINA TEXTILE EXPORTER</span>
          <span class="lang-zh">{companyInfo.name.zh} · 织染缝一体全产业链纺织外贸出口企业</span>
        </div>

        <!-- Main Heading -->
        <h1 class="font-display text-3xl sm:text-5xl lg:text-[50px] font-extrabold tracking-tight leading-[1.15]">
          <span class="lang-en">
            Luoyi Textile Factory: Global Sourcing for
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-300 via-gold-400 to-amber-200">
              Fabrics, Home Textiles & Accessories
            </span>
          </span>
          <span class="lang-zh">
            金华洛屹纺织品：专注全球出口的
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-300 via-gold-400 to-amber-200">
              面料坯布 · 家纺成品 · 纺织配饰
            </span>
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
          <span class="lang-en">
            Headquartered in Yiwu, China ({companyInfo.domain}), <strong>{companyInfo.name.en}</strong> supplies high-density woven greige & dyed fabrics, hotel & retail bedding/towels, and custom scarves & canvas bags to buyers across 28+ countries.
          </span>
          <span class="lang-zh">
            <strong>{companyInfo.name.zh}</strong>（官网：{companyInfo.domain}）坐落于浙江义乌福田街道核心外贸商圈。我们提供从高支高密喷气织造坯布、环保印染成品布，到商超酒店家纺套件、真丝围巾与帆布包袋配饰的一站式 OEM/ODM 外贸定制与全球拼柜出口服务。
          </span>
        </p>

        <!-- 3 Category Quick Jump Pills -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
          <a
            href="#products"
            onclick="window.filterProductCategory && window.filterProductCategory('fabrics')"
            class="group p-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-400/50 transition-all flex items-center justify-between"
          >
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-gold-400">
                <span class="lang-en">01 · Category</span>
                <span class="lang-zh">01 · 核心品类</span>
              </div>
              <div class="text-sm font-semibold text-white mt-0.5">
                <span class="lang-en">Fabrics & Greige</span>
                <span class="lang-zh">面料与梭织坯布</span>
              </div>
            </div>
            <span class="text-slate-400 group-hover:text-gold-300 group-hover:translate-x-1 transition-all">→</span>
          </a>

          <a
            href="#products"
            onclick="window.filterProductCategory && window.filterProductCategory('home-textiles')"
            class="group p-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-400/50 transition-all flex items-center justify-between"
          >
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-gold-400">
                <span class="lang-en">02 · Category</span>
                <span class="lang-zh">02 · 核心品类</span>
              </div>
              <div class="text-sm font-semibold text-white mt-0.5">
                <span class="lang-en">Home Textiles</span>
                <span class="lang-zh">家纺成品系列</span>
              </div>
            </div>
            <span class="text-slate-400 group-hover:text-gold-300 group-hover:translate-x-1 transition-all">→</span>
          </a>

          <a
            href="#products"
            onclick="window.filterProductCategory && window.filterProductCategory('accessories')"
            class="group p-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-400/50 transition-all flex items-center justify-between"
          >
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-gold-400">
                <span class="lang-en">03 · Category</span>
                <span class="lang-zh">03 · 核心品类</span>
              </div>
              <div class="text-sm font-semibold text-white mt-0.5">
                <span class="lang-en">Accessories</span>
                <span class="lang-zh">时尚纺织配饰</span>
              </div>
            </div>
            <span class="text-slate-400 group-hover:text-gold-300 group-hover:translate-x-1 transition-all">→</span>
          </a>
        </div>

        <!-- Primary CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-3">
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl bg-gold-500 hover:bg-gold-600 text-brand-950 font-bold text-sm sm:text-base shadow-lg shadow-gold-500/20 transition-all"
          >
            <span>
              <span class="lang-en">Request Free Swatches & Quote</span>
              <span class="lang-zh">免费索取样布与外贸报价单</span>
            </span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>

          <a
            href="#products"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/20 font-semibold text-sm sm:text-base backdrop-blur-sm transition-all"
          >
            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
              ></path>
            </svg>
            <span>
              <span class="lang-en">Explore Product Center</span>
              <span class="lang-zh">浏览产品中心</span>
            </span>
          </a>
        </div>

        <!-- Certification Trust Strip -->
        <div class="pt-4 border-t border-white/10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-300">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>
              <span class="lang-en">OEKO-TEX® Standard 100</span>
              <span class="lang-zh">OEKO-TEX® 生态纺织品认证</span>
            </span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>
              <span class="lang-en">GRS 4.0 Recycled TC</span>
              <span class="lang-zh">GRS 4.0 全球回收标准</span>
            </span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>
              <span class="lang-en">Verified Business License</span>
              <span class="lang-zh">官方营业执照认证</span>
            </span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>
              <span class="lang-en">Yiwu Market Consolidation</span>
              <span class="lang-zh">义乌国际商贸拼柜集运</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Trio Showcase Card -->
      <div class="lg:col-span-5">
        <div class="relative bg-white/5 border border-white/15 rounded-2xl p-4 sm:p-5 backdrop-blur-md shadow-2xl">
          <div class="grid grid-cols-2 gap-3.5">
            <!-- Card 1: Fabrics & Greige -->
            <div class="col-span-2 relative rounded-xl overflow-hidden group h-48 sm:h-52">
              <img
                src="https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?auto=format&fit=crop&w=900&q=80"
                alt="Fabrics and Greige Goods"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/30 to-transparent"></div>
              <div class="absolute bottom-3.5 left-4 right-4 flex items-end justify-between">
                <div>
                  <span class="px-2 py-0.5 rounded bg-gold-500 text-brand-950 text-[10px] font-extrabold uppercase">
                    <span class="lang-en">01 · Mill Direct</span>
                    <span class="lang-zh">01 · 源头织造</span>
                  </span>
                  <h2 class="text-white font-bold text-base sm:text-lg mt-1">
                    <span class="lang-en">Woven Greige & Dyed Fabrics</span>
                    <span class="lang-zh">高密梭织坯布与成品面料</span>
                  </h2>
                  <p class="text-xs text-slate-300">
                    <span class="lang-en">Cotton, T/C, French Linen, GRS Functional · Width 120cm–320cm</span>
                    <span class="lang-zh">全棉 / 涤棉 / 亚麻天丝 / 三防功能布 · 门幅 120cm–320cm</span>
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 2: Home Textiles -->
            <div class="relative rounded-xl overflow-hidden group h-44">
              <img
                src="https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=600&q=80"
                alt="Home Textiles"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/25 to-transparent"></div>
              <div class="absolute bottom-3 left-3 right-3">
                <span class="text-[10px] font-bold text-gold-300 uppercase">
                  <span class="lang-en">02 · Retail & Hotel</span>
                  <span class="lang-zh">02 · 商超与酒店</span>
                </span>
                <h2 class="text-white font-bold text-sm mt-0.5">
                  <span class="lang-en">Home Textiles</span>
                  <span class="lang-zh">家纺成品系列</span>
                </h2>
                <p class="text-[11px] text-slate-300 line-clamp-1">
                  <span class="lang-en">Bedding, Towels, Curtains, Throws</span>
                  <span class="lang-zh">高支床品/酒店毛巾/遮光帘/盖毯</span>
                </p>
              </div>
            </div>

            <!-- Card 3: Textile Accessories -->
            <div class="relative rounded-xl overflow-hidden group h-44">
              <img
                src="https://images.unsplash.com/photo-1601924994987-69e26d50dc26?auto=format&fit=crop&w=600&q=80"
                alt="Textile Accessories"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/25 to-transparent"></div>
              <div class="absolute bottom-3 left-3 right-3">
                <span class="text-[10px] font-bold text-gold-300 uppercase">
                  <span class="lang-en">03 · Custom OEM</span>
                  <span class="lang-zh">03 · 品牌定制</span>
                </span>
                <h2 class="text-white font-bold text-sm mt-0.5">
                  <span class="lang-en">Fashion Accessories</span>
                  <span class="lang-zh">时尚纺织配饰</span>
                </h2>
                <p class="text-[11px] text-slate-300 line-clamp-1">
                  <span class="lang-en">Silk Scarves, Caps, Ties</span>
                  <span class="lang-zh">真丝围巾/帽饰/领带礼盒</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Bottom Fast Fact Bar inside Showcase -->
          <div
            class="mt-3.5 pt-3 border-t border-white/10 flex items-center justify-between text-xs text-slate-300 px-1"
          >
            <div>
              <span class="text-gold-400 font-bold">
                <span class="lang-en">Yiwu Hub</span>
                <span class="lang-zh">义乌中心</span>
              </span>
              <span class="lang-en"> Showroom & Consolidation</span>
              <span class="lang-zh"> 福田街道展厅与拼柜</span>
            </div>
            <div class="h-3 w-px bg-white/15"></div>
            <div>
              <span class="text-gold-400 font-bold">
                <span class="lang-en">Free A4</span>
                <span class="lang-zh">免费A4样</span>
              </span>
              <span class="lang-en"> Quality Swatches</span>
              <span class="lang-zh"> 免费寄送品质样布</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
