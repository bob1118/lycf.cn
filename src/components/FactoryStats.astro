---
import { companyInfo, factoryStats, workshopGallery } from '../data/siteContent';
---

<section id="about" class="py-20 md:py-28 bg-brand-900 text-white relative overflow-hidden">
  <!-- Decorative Background Pattern -->
  <div class="absolute inset-0 bg-hero-grid opacity-50 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Row 1: Company Profile & Official Registration Info -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-12">
      <!-- Left 7 Cols: Company Introduction -->
      <div class="lg:col-span-7 space-y-5">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-gold-300 text-xs font-bold uppercase tracking-wider border border-white/10"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
          <span class="lang-en">About Us · {companyInfo.name.en}</span>
          <span class="lang-zh">关于我们 · {companyInfo.name.zh}</span>
        </div>

        <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
          <span class="lang-en">
            Rooted in Yiwu International Trade Hub, Delivering Reliable Textile Manufacturing Worldwide
          </span>
          <span class="lang-zh">
            立足中国义乌国际商贸核心区，链接全球的源头纺织品制造与出口企业
          </span>
        </h2>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          <span class="lang-en">
            <strong>{companyInfo.name.en}</strong> (Brand: <strong>Luoyi Textile Factory</strong>) is located at Room 301, No. 62 Chengxin 3rd Street, Futian Sub-district, Yiwu City, Zhejiang Province — right adjacent to the world-renowned Yiwu International Trade City.
          </span>
          <span class="lang-zh">
            <strong>{companyInfo.name.zh}</strong>总部位于浙江省金华市义乌市福田街道诚信三街62号301室，紧邻享誉全球的义乌国际商贸城，具备得天独厚的国际物流与外贸供应链集聚优势。
          </span>
        </p>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          <span class="lang-en">
            We integrate air-jet weaving, reactive dyeing & digital printing, and automated sewing lines across three specialized business divisions: <strong>1. Woven Fabrics & Greige Goods</strong>, <strong>2. Finished Home Textiles</strong>, and <strong>3. Custom Fashion Textile Accessories</strong>. Whether you require full-container greige cloth or multi-category OEM consolidation, Luoyi Textile ensures strict quality inspection and on-time global delivery.
          </span>
          <span class="lang-zh">
            公司深耕纺织外贸出口领域，打通“织造定织—环保印染—自动化裁剪缝制—智能检针包装”全产业链，重点布局<strong>【面料与坯布】、【家纺成品】、【纺织配饰】</strong>三大业务板块。无论您是整柜采购坯布面料，还是进行多品类家纺配饰 OEM 贴牌与义乌市场拼柜集运，洛屹纺织均能提供高性价比的源头工厂价格与高标准履约保障。
          </span>
        </p>
      </div>

      <!-- Right 5 Cols: Official Registration Summary Card -->
      <div class="lg:col-span-5">
        <div class="p-6 sm:p-7 rounded-2xl bg-white/5 border border-white/15 backdrop-blur-md space-y-4">
          <div class="flex items-center gap-3 pb-4 border-b border-white/10">
            <img src={companyInfo.logoUrl} alt="Luoyi Logo" class="w-11 h-11 rounded-xl bg-white p-1 object-contain shrink-0" />
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-gold-400">
                <span class="lang-en">Enterprise Registration Profile</span>
                <span class="lang-zh">企业工商注册档案</span>
              </div>
              <div class="font-display font-bold text-base text-white mt-0.5">
                <span class="lang-en">{companyInfo.name.en}</span>
                <span class="lang-zh">{companyInfo.name.zh}</span>
              </div>
            </div>
          </div>

          <div class="space-y-3 text-xs sm:text-sm">
            <div>
              <span class="text-slate-400 block text-xs">
                <span class="lang-en">Registered Company Name:</span>
                <span class="lang-zh">企业注册全称：</span>
              </span>
              <strong class="text-white mt-0.5 block">
                <span class="lang-en">{companyInfo.name.en}</span>
                <span class="lang-zh">{companyInfo.name.zh}</span>
              </strong>
            </div>

            <div>
              <span class="text-slate-400 block text-xs">
                <span class="lang-en">Direct Phone / WeChat & Official Email:</span>
                <span class="lang-zh">联系电话 / 微信与官方邮箱：</span>
              </span>
              <strong class="text-gold-300 mt-0.5 block">
                {companyInfo.phone} &nbsp;|&nbsp; {companyInfo.email}
              </strong>
            </div>

            <div class="pt-2 border-t border-white/10">
              <span class="text-slate-400 block text-xs">
                <span class="lang-en">Registered Headquarters Address:</span>
                <span class="lang-zh">企业注册地址：</span>
              </span>
              <strong class="text-slate-200 mt-0.5 block leading-snug">
                <span class="lang-en">{companyInfo.address.en}</span>
                <span class="lang-zh">{companyInfo.address.zh}</span>
              </strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 2 (Dedicated Full Row): Official Business License Showcase (Landscape 841×595 Adaptive Layout) -->
    <div class="mb-16 pb-16 border-b border-white/10">
      <div class="rounded-2xl bg-white/5 border border-white/15 p-6 sm:p-8 backdrop-blur-md">
        <!-- Row Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gold-500/20 border border-gold-400/30 text-gold-300 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="font-display font-bold text-lg sm:text-xl text-white">
                <span class="lang-en">Official Business License & Qualification Public Display</span>
                <span class="lang-zh">官方营业执照资质公示</span>
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 mt-0.5">
                <span class="lang-en">
                  Both Chinese Original and Certified English Translation are displayed in full landscape ratio. Click either certificate to inspect in high resolution.
                </span>
                <span class="lang-zh">
                  完整展示企业营业执照【中文原件】与【英文认证版】（横版全幅自适应），点击任意执照图片可高清放大核验。
                </span>
              </p>
            </div>
          </div>

          <span class="self-start sm:self-auto px-3 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-bold shrink-0">
            <span class="lang-en">✓ Verified Enterprise Qualification</span>
            <span class="lang-zh">✓ 官方工商资质已核验</span>
          </span>
        </div>

        <!-- Side-by-Side Full Landscape License Cards (Compact Adaptive Layout) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
          <!-- English License Card -->
          <button
            type="button"
            onclick={`window.openLicenseModal('${companyInfo.licenseEnUrl}', 'Business License (English Translation)', '营业执照（英文认证版）')`}
            class="group rounded-xl overflow-hidden bg-slate-950/80 border border-white/15 hover:border-gold-400 transition-all text-left flex flex-col shadow-lg max-w-[520px] w-full mx-auto lg:mx-0"
          >
            <div class="w-full bg-white p-2 sm:p-2.5 flex items-center justify-center overflow-hidden">
              <img
                src={companyInfo.licenseEnUrl}
                alt="Jinhua Luoyi Textile Co., Ltd. Business License (English)"
                width="841"
                height="595"
                loading="lazy"
                class="w-full h-auto max-h-[260px] sm:max-h-[290px] object-contain rounded group-hover:scale-[1.01] transition-transform duration-300"
              />
            </div>
            <div class="px-3 py-2 bg-brand-950 border-t border-white/10 flex items-center justify-between text-xs w-full">
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
                <span class="font-semibold text-white">
                  <span class="lang-en">Business License (EN)</span>
                  <span class="lang-zh">营业执照（英文认证版）</span>
                </span>
              </div>
              <span class="text-gold-400 font-medium inline-flex items-center gap-1 group-hover:underline">
                <span class="lang-en">View 🔍</span>
                <span class="lang-zh">查看 🔍</span>
              </span>
            </div>
          </button>

          <!-- Chinese License Card -->
          <button
            type="button"
            onclick={`window.openLicenseModal('${companyInfo.licenseZhUrl}', 'Business License (Chinese Original)', '营业执照（中文正本）')`}
            class="group rounded-xl overflow-hidden bg-slate-950/80 border border-white/15 hover:border-gold-400 transition-all text-left flex flex-col shadow-lg max-w-[520px] w-full mx-auto lg:mx-0"
          >
            <div class="w-full bg-white p-2 sm:p-2.5 flex items-center justify-center overflow-hidden">
              <img
                src={companyInfo.licenseZhUrl}
                alt="金华洛屹纺织品有限公司 营业执照 (中文)"
                width="841"
                height="595"
                loading="lazy"
                class="w-full h-auto max-h-[260px] sm:max-h-[290px] object-contain rounded group-hover:scale-[1.01] transition-transform duration-300"
              />
            </div>
            <div class="px-3 py-2 bg-brand-950 border-t border-white/10 flex items-center justify-between text-xs w-full">
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
                <span class="font-semibold text-white">
                  <span class="lang-en">Business License (CN)</span>
                  <span class="lang-zh">营业执照（中文正本）</span>
                </span>
              </div>
              <span class="text-gold-400 font-medium inline-flex items-center gap-1 group-hover:underline">
                <span class="lang-en">View 🔍</span>
                <span class="lang-zh">查看 🔍</span>
              </span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <!-- Row 3: 4 Key Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
      {
        factoryStats.map((stat) => (
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-gold-400/50 transition-all backdrop-blur-sm">
            <div class="flex items-baseline gap-1.5">
              <span class="font-display text-3xl sm:text-4xl font-extrabold text-gold-400">{stat.number}</span>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-300">
                <span class="lang-en">{stat.unit.en}</span>
                <span class="lang-zh">{stat.unit.zh}</span>
              </span>
            </div>
            <h3 class="mt-2.5 font-display font-bold text-base sm:text-lg text-white">
              <span class="lang-en">{stat.title.en}</span>
              <span class="lang-zh">{stat.title.zh}</span>
            </h3>
            <p class="mt-1.5 text-xs sm:text-sm text-slate-300 leading-relaxed">
              <span class="lang-en">{stat.desc.en}</span>
              <span class="lang-zh">{stat.desc.zh}</span>
            </p>
          </div>
        ))
      }
    </div>

    <!-- Row 4: Workshop Real-Scene Gallery Grid -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-gold-300">
          <span class="lang-en">Production Workshops & Yiwu Consolidation Center</span>
          <span class="lang-zh">核心生产车间与义乌仓储监装中心</span>
        </h3>
        <span class="text-xs text-slate-400 hidden sm:inline">
          <span class="lang-en">Welcome to visit our Yiwu office & showroom at Futian Sub-district</span>
          <span class="lang-zh">欢迎国内外客商莅临义乌市福田街道诚信三街62号301室实地考察</span>
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          workshopGallery.map((item) => (
            <div class="group relative rounded-2xl overflow-hidden h-64 border border-white/15 bg-brand-950">
              <img
                src={item.image}
                alt={item.title.en}
                loading="lazy"
                class="w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/30 to-transparent" />
              <div class="absolute top-3 left-3">
                <span class="px-2.5 py-1 rounded-md bg-brand-950/80 border border-white/15 text-[11px] font-bold text-gold-300 backdrop-blur-sm">
                  <span class="lang-en">{item.tag.en}</span>
                  <span class="lang-zh">{item.tag.zh}</span>
                </span>
              </div>
              <div class="absolute bottom-4 left-4 right-4">
                <h4 class="font-display font-bold text-base text-white leading-snug">
                  <span class="lang-en">{item.title.en}</span>
                  <span class="lang-zh">{item.title.zh}</span>
                </h4>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Lightbox Modal for Business License Inspection -->
  <div
    id="license-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <div class="bg-white rounded-2xl max-w-5xl w-full max-h-[92vh] overflow-hidden shadow-2xl flex flex-col">
      <div class="px-5 py-3.5 bg-brand-900 text-white flex items-center justify-between">
        <span id="license-modal-title" class="font-display font-bold text-sm">Business License</span>
        <button
          type="button"
          onclick="window.closeLicenseModal()"
          class="p-1 rounded-lg text-slate-300 hover:text-white hover:bg-white/10"
        >
          ✕
        </button>
      </div>
      <div class="p-4 sm:p-6 overflow-auto bg-slate-100 flex-1 flex items-center justify-center">
        <img id="license-modal-img" src="" alt="Business License" class="max-h-[80vh] w-auto object-contain rounded shadow" />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  window.openLicenseModal = function (imgUrl, titleEn, titleZh) {
    var modal = document.getElementById('license-modal');
    var img = document.getElementById('license-modal-img');
    var title = document.getElementById('license-modal-title');
    var currentLang = document.documentElement.getAttribute('data-lang') || 'en';
    if (!modal || !img) return;
    img.src = imgUrl;
    if (title) title.textContent = currentLang === 'zh' ? titleZh : titleEn;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeLicenseModal = function () {
    var modal = document.getElementById('license-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('license-modal');
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) {
          window.closeLicenseModal();
        }
      });
    }
  });
</script>
