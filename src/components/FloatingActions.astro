---
import { companyInfo } from '../data/siteContent';
---

<div class="fixed right-4 bottom-6 z-40 flex flex-col gap-2.5">
  <!-- WeChat Direct Button -->
  <a
    href="#contact"
    title="WeChat / Tel"
    class="group flex items-center justify-end"
  >
    <span
      class="mr-2 hidden group-hover:inline-block px-3 py-1.5 rounded-lg bg-brand-900 text-white text-xs font-semibold shadow-lg whitespace-nowrap"
    >
      <span class="lang-en">WeChat: {companyInfo.phone}</span>
      <span class="lang-zh">微信同号：{companyInfo.phone}</span>
    </span>
    <div
      class="w-12 h-12 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white shadow-lg flex items-center justify-center transition-transform hover:scale-105"
    >
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M8.5 4C4.91 4 2 6.46 2 9.5c0 1.66.88 3.15 2.26 4.16L3.5 16l2.35-1.18c.83.24 1.72.38 2.65.38.34 0 .68-.02 1.01-.06-.2-.59-.31-1.22-.31-1.89 0-3.31 3.13-6 7-6 .35 0 .69.03 1.03.07C16.56 5.38 12.88 4 8.5 4zm-2.25 3.5c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm4.5 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM16.2 8.5c-3.2 0-5.8 2.19-5.8 4.9 0 2.71 2.6 4.9 5.8 4.9.75 0 1.47-.12 2.13-.34L20.5 19l-.63-1.95C21.02 16.19 22 14.89 22 13.4c0-2.71-2.6-4.9-5.8-4.9zm-1.95 3c.47 0 .85.38.85.85s-.38.85-.85.85-.85-.38-.85-.85.38-.85.85-.85zm3.9 0c.47 0 .85.38.85.85s-.38.85-.85.85-.85-.38-.85-.85.38-.85.85-.85z"
        ></path>
      </svg>
    </div>
  </a>

  <!-- Quick RFQ Form Anchor -->
  <a href="#contact" title="Request a Quote" class="group flex items-center justify-end">
    <span
      class="mr-2 hidden group-hover:inline-block px-3 py-1.5 rounded-lg bg-brand-900 text-white text-xs font-semibold shadow-lg whitespace-nowrap"
    >
      <span class="lang-en">Get Free Swatches & Quote</span>
      <span class="lang-zh">免费索样与获取报价</span>
    </span>
    <div
      class="w-12 h-12 rounded-full bg-gold-500 hover:bg-gold-600 text-brand-950 shadow-lg flex items-center justify-center transition-transform hover:scale-105"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
        ></path>
      </svg>
    </div>
  </a>

  <!-- Scroll to Top -->
  <button
    type="button"
    onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
    title="Back to top"
    class="w-12 h-12 rounded-full bg-brand-900/90 hover:bg-brand-800 text-white border border-white/15 shadow-lg flex items-center justify-center transition-transform hover:scale-105"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
    </svg>
  </button>
</div>
