---
import { categoryTabs, productsData } from '../data/siteContent';
---

<section id="products" class="py-20 md:py-28 bg-weave-pattern relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-100 text-brand-800 text-xs font-bold uppercase tracking-wider mb-3"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-brand-800"></span>
        <span class="lang-en">3 Core Export Divisions · {productsData.length} Flagship Series</span>
        <span class="lang-zh">三大核心出口事业部 · {productsData.length}大外贸主力产品线</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-brand-900 tracking-tight">
        <span class="lang-en">Export Product Matrix & Technical Specifications</span>
        <span class="lang-zh">核心出口产品矩阵与外贸规格参数</span>
      </h2>
      <p class="mt-3 text-slate-600 text-base sm:text-lg">
        <span class="lang-en">
          Switch between our three specialized divisions below. Click any product card to view complete technical data sheets or add directly to your RFQ inquiry.
        </span>
        <span class="lang-zh">
          点击下方选项卡切换【面料与坯布】、【家纺成品】、【纺织配饰】三大产品线。可点击任意产品查看详细工艺参数表或一键加入询盘单。
        </span>
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div
      class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-10 max-w-5xl mx-auto"
      role="tablist"
      aria-label="Product Categories"
    >
      {
        categoryTabs.map((tab, idx) => (
          <button
            type="button"
            data-category-tab={tab.key}
            onclick={`window.filterProductCategory('${tab.key}')`}
            class={`category-tab-btn text-left p-4 rounded-xl border transition-all duration-200 focus:outline-none ${
              idx === 0
                ? 'bg-brand-900 text-white border-brand-900 shadow-lg'
                : 'bg-white text-slate-800 border-slate-200/90 hover:border-brand-400 hover:bg-slate-50'
            }`}
          >
            <div class="flex items-center justify-between mb-1">
              <span class="font-display font-bold text-sm sm:text-base">
                <span class="lang-en">{tab.label.en}</span>
                <span class="lang-zh">{tab.label.zh}</span>
              </span>
              <span
                class={`tab-count-badge text-xs font-bold px-2 py-0.5 rounded-full ${
                  idx === 0 ? 'bg-gold-500 text-brand-950' : 'bg-slate-100 text-slate-600'
                }`}
              >
                {tab.count}
              </span>
            </div>
            <p class={`tab-sub-label text-xs truncate ${idx === 0 ? 'text-slate-300' : 'text-slate-500'}`}>
              <span class="lang-en">{tab.subLabel.en}</span>
              <span class="lang-zh">{tab.subLabel.zh}</span>
            </p>
          </button>
        ))
      }
    </div>

    <!-- Product Grid -->
    <div id="product-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {
        [...productsData].sort((a, b) => b.code.localeCompare(a.code)).map((product) => (
          <article
            data-product-card
            data-category={product.category}
            class="bg-white rounded-2xl border border-slate-200/90 shadow-soft hover:shadow-card transition-all duration-300 flex flex-col overflow-hidden group"
          >
            <!-- Product Image Header -->
            <div class="relative h-56 overflow-hidden bg-slate-100">
              <img
                src={product.image}
                alt={product.name.en}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950/65 via-transparent to-transparent" />

              <!-- Top Badges -->
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
                <span class="px-2.5 py-1 rounded-md bg-brand-900/90 text-white backdrop-blur-sm text-[11px] font-bold tracking-wide">
                  <span class="lang-en">{product.categoryLabel.en}</span>
                  <span class="lang-zh">{product.categoryLabel.zh}</span>
                </span>
                {product.badge && (
                  <span class="px-2.5 py-1 rounded-md bg-gold-500 text-brand-950 text-[11px] font-extrabold shadow-sm">
                    <span class="lang-en">{product.badge.en}</span>
                    <span class="lang-zh">{product.badge.zh}</span>
                  </span>
                )}
              </div>

              <!-- Bottom Code & Certs -->
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs text-white">
                <span class="font-mono font-semibold bg-black/40 px-2 py-0.5 rounded backdrop-blur-sm">
                  #{product.code}
                </span>
                <div class="flex items-center gap-1.5">
                  {product.certifications.slice(0, 2).map((cert) => (
                    <span class="px-2 py-0.5 rounded bg-white/20 backdrop-blur-md text-[10px] font-semibold">
                      {cert}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Card Content Body -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-display font-bold text-lg text-brand-900 group-hover:text-brand-700 transition-colors leading-snug">
                  <span class="lang-en">{product.name.en}</span>
                  <span class="lang-zh">{product.name.zh}</span>
                </h3>
                <p class="mt-2 text-xs sm:text-sm text-slate-600 line-clamp-2 leading-relaxed">
                  <span class="lang-en">{product.summary.en}</span>
                  <span class="lang-zh">{product.summary.zh}</span>
                </p>

                <!-- Key B2B Spec Table inside Card -->
                <div class="mt-4 pt-3.5 border-t border-slate-100 space-y-2 text-xs">
                  <div class="flex items-start justify-between gap-2">
                    <span class="text-slate-400 font-medium shrink-0">
                      <span class="lang-en">Composition:</span>
                      <span class="lang-zh">材质成分：</span>
                    </span>
                    <span class="text-slate-800 font-semibold text-right">
                      <span class="lang-en">{product.composition.en}</span>
                      <span class="lang-zh">{product.composition.zh}</span>
                    </span>
                  </div>

                  <div class="flex items-start justify-between gap-2">
                    <span class="text-slate-400 font-medium shrink-0">
                      <span class="lang-en">Key Specs:</span>
                      <span class="lang-zh">核心规格：</span>
                    </span>
                    <span class="text-brand-800 font-semibold text-right">
                      <span class="lang-en">{product.specHighlight.en}</span>
                      <span class="lang-zh">{product.specHighlight.zh}</span>
                    </span>
                  </div>

                  <div class="flex items-center justify-between gap-2">
                    <span class="text-slate-400 font-medium shrink-0">
                      <span class="lang-en">MOQ & Lead Time:</span>
                      <span class="lang-zh">起订与交期：</span>
                    </span>
                    <span class="text-slate-700 font-medium text-right">
                      <span class="lang-en">
                        {product.moq.en} · {product.leadTime.en}
                      </span>
                      <span class="lang-zh">
                        {product.moq.zh} · {product.leadTime.zh}
                      </span>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Card Action Buttons -->
              <div class="mt-5 pt-4 border-t border-slate-100 grid grid-cols-2 gap-2.5">
                <button
                  type="button"
                  onclick={`window.openProductModal('${product.id}')`}
                  class="py-2.5 px-3 rounded-lg border border-slate-200 hover:border-brand-700 text-slate-700 hover:text-brand-800 font-semibold text-xs inline-flex items-center justify-center gap-1.5 transition-all"
                >
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                  <span class="lang-en">Tech Specs</span>
                  <span class="lang-zh">详细参数表</span>
                </button>

                <button
                  type="button"
                  onclick={`window.selectProductForQuote('${product.code}', '${product.name.en.replace(/'/g, "\\'")}', '${product.name.zh.replace(/'/g, "\\'")}', '${product.category}')`}
                  class="py-2.5 px-3 rounded-lg bg-brand-800 hover:bg-brand-900 text-white font-semibold text-xs inline-flex items-center justify-center gap-1.5 shadow-sm transition-all"
                >
                  <span class="lang-en">Inquire Item</span>
                  <span class="lang-zh">索样 / 询价</span>
                  <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Custom Spec Sourcing Banner -->
    <div
      class="mt-12 rounded-2xl bg-gradient-to-r from-brand-900 via-brand-800 to-brand-900 p-6 sm:p-8 text-white shadow-xl flex flex-col lg:flex-row items-center justify-between gap-6"
    >
      <div class="space-y-1.5 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 text-gold-400 text-xs font-bold uppercase tracking-wider">
          <span class="lang-en">★ Custom Weaving, Dyeing & OEM Sewing</span>
          <span class="lang-zh">★ 支持来样定织、潘通对色印染与成品 OEM 贴牌</span>
        </div>
        <h3 class="font-display text-xl sm:text-2xl font-bold">
          <span class="lang-en">Need a custom yarn count, GSM, Pantone shade, or bespoke retail design?</span>
          <span class="lang-zh">需要特殊纱支密度、定制克重门幅、专属潘通色号或来图来样定制？</span>
        </h3>
        <p class="text-slate-300 text-sm">
          <span class="lang-en">
            Mail us your physical swatch or tech pack — we replicate any fabric construction or finished textile within 5–7 days.
          </span>
          <span class="lang-zh">
            支持寄送实物样布或发送设计工艺单（Tech Pack），我们可在 5–7 天内完成分析定织、打色卡或成品复刻打样。
          </span>
        </p>
      </div>
      <a
        href="#contact"
        class="shrink-0 px-6 py-3.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-brand-950 font-bold text-sm shadow-md transition-all"
      >
        <span class="lang-en">Submit Custom Tech Pack →</span>
        <span class="lang-zh">提交定制开发需求 →</span>
      </a>
    </div>
  </div>

  <!-- Product Technical Specification Modal -->
  <div
    id="product-spec-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-brand-950/75 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <div
      class="bg-white rounded-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-slate-200 animate-fadeIn"
    >
      {
        productsData.map((product) => (
          <div data-modal-content={product.id} class="hidden">
            <!-- Modal Top Bar -->
            <div class="sticky top-0 z-10 bg-white/95 backdrop-blur border-b border-slate-200 px-6 py-4 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-brand-900 text-white">
                  #{product.code}
                </span>
                <span class="text-xs font-semibold text-gold-700 bg-gold-100 px-2.5 py-1 rounded">
                  <span class="lang-en">{product.categoryLabel.en}</span>
                  <span class="lang-zh">{product.categoryLabel.zh}</span>
                </span>
              </div>
              <button
                type="button"
                onclick="window.closeProductModal()"
                class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors"
                aria-label="Close modal"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 sm:p-8 space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
                <div class="sm:col-span-5 rounded-xl overflow-hidden h-52 bg-slate-100 border border-slate-200">
                  <img src={product.image} alt={product.name.en} class="w-full h-full object-cover" />
                </div>
                <div class="sm:col-span-7 space-y-3">
                  <h3 class="font-display text-xl sm:text-2xl font-bold text-brand-900">
                    <span class="lang-en">{product.name.en}</span>
                    <span class="lang-zh">{product.name.zh}</span>
                  </h3>
                  <p class="text-sm text-slate-600 leading-relaxed">
                    <span class="lang-en">{product.summary.en}</span>
                    <span class="lang-zh">{product.summary.zh}</span>
                  </p>
                  <div class="flex flex-wrap gap-2 pt-1">
                    {product.certifications.map((cert) => (
                      <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold">
                        ✓ {cert}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Detailed Technical Specifications Table -->
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
                  <span class="lang-en">Export Technical Data Sheet & Parameters</span>
                  <span class="lang-zh">外贸出口技术参数与定制标准</span>
                </h4>
                <div class="rounded-xl border border-slate-200 overflow-hidden divide-y divide-slate-200 text-sm">
                  <div class="grid grid-cols-3 bg-slate-50/70 px-4 py-3">
                    <span class="font-semibold text-slate-600">
                      <span class="lang-en">Material Composition</span>
                      <span class="lang-zh">原料成分</span>
                    </span>
                    <span class="col-span-2 font-semibold text-brand-900">
                      <span class="lang-en">{product.composition.en}</span>
                      <span class="lang-zh">{product.composition.zh}</span>
                    </span>
                  </div>

                  {product.detailedSpecs.map((spec) => (
                    <div class="grid grid-cols-3 px-4 py-3 bg-white">
                      <span class="font-medium text-slate-500">
                        <span class="lang-en">{spec.label.en}</span>
                        <span class="lang-zh">{spec.label.zh}</span>
                      </span>
                      <span class="col-span-2 text-slate-800 font-medium">
                        <span class="lang-en">{spec.value.en}</span>
                        <span class="lang-zh">{spec.value.zh}</span>
                      </span>
                    </div>
                  ))}

                  <div class="grid grid-cols-3 bg-slate-50/70 px-4 py-3">
                    <span class="font-semibold text-slate-600">
                      <span class="lang-en">MOQ & Lead Time</span>
                      <span class="lang-zh">起订量与交货期</span>
                    </span>
                    <span class="col-span-2 font-semibold text-brand-800">
                      <span class="lang-en">
                        {product.moq.en} | {product.leadTime.en} ({product.originPort.en})
                      </span>
                      <span class="lang-zh">
                        {product.moq.zh} | {product.leadTime.zh} ({product.originPort.zh})
                      </span>
                    </span>
                  </div>

                  <div class="grid grid-cols-3 px-4 py-3 bg-white">
                    <span class="font-medium text-slate-500">
                      <span class="lang-en">End Applications</span>
                      <span class="lang-zh">适用终端场景</span>
                    </span>
                    <span class="col-span-2 text-slate-700">
                      <span class="lang-en">{product.applications.en}</span>
                      <span class="lang-zh">{product.applications.zh}</span>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Modal Footer CTA -->
              <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-100">
                <p class="text-xs text-slate-500">
                  <span class="lang-en">Free A4 quality swatch & lab dips available upon request.</span>
                  <span class="lang-zh">支持免费申领该款 A4 品质样布、色卡及外贸阶梯报价单。</span>
                </p>
                <div class="flex items-center gap-3 w-full sm:w-auto">
                  <button
                    type="button"
                    onclick="window.closeProductModal()"
                    class="px-4 py-2.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 text-xs font-semibold"
                  >
                    <span class="lang-en">Close</span>
                    <span class="lang-zh">关闭窗口</span>
                  </button>
                  <button
                    type="button"
                    onclick={`window.closeProductModal(); window.selectProductForQuote('${product.code}', '${product.name.en.replace(/'/g, "\\'")}', '${product.name.zh.replace(/'/g, "\\'")}', '${product.category}')`}
                    class="flex-1 sm:flex-initial px-5 py-2.5 rounded-lg bg-brand-800 hover:bg-brand-900 text-white text-xs font-bold shadow-md transition-all"
                  >
                    <span class="lang-en">Request Quote & Sample for #{product.code} →</span>
                    <span class="lang-zh">针对 #{product.code} 索样与询价 →</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  window.filterProductCategory = function (categoryKey) {
    // Update Tab Buttons
    document.querySelectorAll('[data-category-tab]').forEach(function (btn) {
      var key = btn.getAttribute('data-category-tab');
      var badge = btn.querySelector('.tab-count-badge');
      var subLabel = btn.querySelector('.tab-sub-label');
      if (key === categoryKey) {
        btn.classList.add('bg-brand-900', 'text-white', 'border-brand-900', 'shadow-lg');
        btn.classList.remove('bg-white', 'text-slate-800', 'border-slate-200/90', 'hover:bg-slate-50');
        if (badge) {
          badge.classList.add('bg-gold-500', 'text-brand-950');
          badge.classList.remove('bg-slate-100', 'text-slate-600');
        }
        if (subLabel) {
          subLabel.classList.add('text-slate-300');
          subLabel.classList.remove('text-slate-500');
        }
      } else {
        btn.classList.remove('bg-brand-900', 'text-white', 'border-brand-900', 'shadow-lg');
        btn.classList.add('bg-white', 'text-slate-800', 'border-slate-200/90', 'hover:bg-slate-50');
        if (badge) {
          badge.classList.remove('bg-gold-500', 'text-brand-950');
          badge.classList.add('bg-slate-100', 'text-slate-600');
        }
        if (subLabel) {
          subLabel.classList.remove('text-slate-300');
          subLabel.classList.add('text-slate-500');
        }
      }
    });

    // Filter Cards
    document.querySelectorAll('[data-product-card]').forEach(function (card) {
      var cardCat = card.getAttribute('data-category');
      if (categoryKey === 'all' || cardCat === categoryKey) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  };

  window.openProductModal = function (productId) {
    var modal = document.getElementById('product-spec-modal');
    if (!modal) return;
    document.querySelectorAll('[data-modal-content]').forEach(function (el) {
      if (el.getAttribute('data-modal-content') === productId) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeProductModal = function () {
    var modal = document.getElementById('product-spec-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  // Close modal on backdrop click or Escape key
  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('product-spec-modal');
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) {
          window.closeProductModal();
        }
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        window.closeProductModal();
      }
    });
  });
</script>
