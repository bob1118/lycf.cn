---
import { certificationsList } from '../data/siteContent';
---

<section id="certifications" class="py-20 md:py-28 bg-slate-50 border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Quality Commitment & Lab Testing -->
      <div class="lg:col-span-5 space-y-6">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
          <span class="lang-en">Global Compliance & Quality Assurance</span>
          <span class="lang-zh">国际合规认证与严苛品质管控体系</span>
        </div>

        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-brand-900 tracking-tight leading-tight">
          <span class="lang-en">Certified Sustainable Textiles That Pass Global Customs & Retail Audits</span>
          <span class="lang-zh">符合欧美日韩严苛环保标准，护航跨国通关与商超验货</span>
        </h2>

        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          <span class="lang-en">
            International buyers face strict chemical and sustainability regulations (EU REACH, US CPSIA, California Prop 65). Our fabrics and finished goods are tested batch-by-batch in our internal lab and verified by SGS, Intertek (ITS), and Bureau Veritas (BV).
          </span>
          <span class="lang-zh">
            针对欧美市场严格的环保与化学品法规（欧盟 REACH、美国 CPSIA、加州65法案等），金华洛屹纺织品建立了从原纱进厂到成品出库的全检机制，并长期与 SGS、Intertek 天祥、BV 必维等国际权威检测机构合作。
          </span>
        </p>

        <!-- Lab Test Standards Checklist Card -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-soft space-y-3.5">
          <h3 class="font-display font-bold text-base text-brand-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
            <span class="lang-en">In-House Physical & Chemical Lab Testing</span>
            <span class="lang-zh">出厂必检物理与化学指标清单</span>
          </h3>

          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
            <li class="flex items-center justify-between py-1.5 border-b border-slate-100">
              <span class="font-medium">
                <span class="lang-en">Color Fastness to Washing / Rubbing</span>
                <span class="lang-zh">耐水洗 / 耐干湿摩擦色牢度</span>
              </span>
              <span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">
                ISO 105 / AATCC ≥ 4.0
              </span>
            </li>
            <li class="flex items-center justify-between py-1.5 border-b border-slate-100">
              <span class="font-medium">
                <span class="lang-en">Dimensional Stability (Shrinkage)</span>
                <span class="lang-zh">水洗尺寸稳定性（缩水率控制）</span>
              </span>
              <span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">Warp/Weft ≤ ±3%</span>
            </li>
            <li class="flex items-center justify-between py-1.5 border-b border-slate-100">
              <span class="font-medium">
                <span class="lang-en">Pilling & Martindale Abrasion</span>
                <span class="lang-zh">抗起毛起球与马丁代尔耐磨测试</span>
              </span>
              <span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">Grade 4.0–4.5</span>
            </li>
            <li class="flex items-center justify-between py-1.5">
              <span class="font-medium">
                <span class="lang-en">pH Value & Formaldehyde Content</span>
                <span class="lang-zh">pH值酸碱度与游离甲醛检测</span>
              </span>
              <span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">
                ND (Non-Detectable)
              </span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: 4 International Certification Cards -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          certificationsList.map((cert) => (
            <div class="p-6 sm:p-7 rounded-2xl bg-white border border-slate-200/90 shadow-soft hover:shadow-card transition-all flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-brand-900 text-gold-400 flex items-center justify-center mb-5 shadow-sm">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                    />
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-gold-700 bg-gold-100 px-2.5 py-1 rounded">
                  <span class="lang-en">{cert.category.en}</span>
                  <span class="lang-zh">{cert.category.zh}</span>
                </span>
                <h3 class="mt-3 font-display text-lg font-extrabold text-brand-900">{cert.code}</h3>
                <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed">
                  <span class="lang-en">{cert.desc.en}</span>
                  <span class="lang-zh">{cert.desc.zh}</span>
                </p>
              </div>

              <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <span>
                  <span class="lang-en">Verified Certificate Copy Available</span>
                  <span class="lang-zh">支持向采购商提供证书扫描件核验</span>
                </span>
                <span class="text-emerald-600 font-bold">
                  <span class="lang-en">● Active</span>
                  <span class="lang-zh">● 有效期内</span>
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
